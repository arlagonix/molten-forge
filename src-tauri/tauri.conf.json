{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Molten Forge",
  "version": "0.36.93",
  "identifier": "com.moltenforge.pi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Molten Forge",
        "width": 1180,
        "height": 800,
        "minWidth": 820,
        "minHeight": 520,
        "resizable": true,
        "theme": "Dark",
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ]
  }
}
