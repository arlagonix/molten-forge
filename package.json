{
  "name": "molten-forge-pi",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "node --test scripts/sync-tauri-lock.test.mjs scripts/prepare-miracode.test.mjs scripts/release-metadata.test.mjs && vitest run --dir src && tsc --noEmit",
    "test:watch": "vitest --dir src",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run test && npm run build && npm run test:rust",
    "test:unit": "vitest run --dir src",
    "pretauri:build": "node scripts/sync-tauri-lock.mjs",
    "pretauri:dev": "node scripts/sync-tauri-lock.mjs",
    "prebuild": "node scripts/prepare-miracode.mjs",
    "predev": "node scripts/prepare-miracode.mjs"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@fontsource/jetbrains-mono": "^5.0.0",
    "@lezer/highlight": "^1.2.2",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/plugin-notification": "2.6.0",
    "katex": "^0.16.0",
    "lucide-react": "^0.564.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0",
    "@types/node": "^24.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
